{
  "manifest_version": 3,
  "name": "Eclipse: what's playing",
  "version": "1.3.0",
  "description": "Tells the Eclipse app on this computer which episode you're watching on Disney+, NOW and other services. Nothing leaves your computer.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:47615/*",
    "https://*.disneyplus.com/*",
    "https://*.nowtv.com/*",
    "https://*.now.com/*",
    "https://*.netflix.com/*",
    "https://*.primevideo.com/*",
    "https://*.amazon.co.uk/gp/video/*",
    "https://*.amazon.com/gp/video/*",
    "https://*.bbc.co.uk/iplayer/*",
    "https://*.itv.com/watch/*",
    "https://*.channel4.com/*",
    "https://tv.apple.com/*",
    "https://*.paramountplus.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.disneyplus.com/*",
        "https://*.nowtv.com/*",
        "https://*.now.com/*",
        "https://*.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://*.amazon.co.uk/gp/video/*",
        "https://*.amazon.com/gp/video/*",
        "https://*.bbc.co.uk/iplayer/*",
        "https://*.itv.com/watch/*",
        "https://*.channel4.com/*",
        "https://tv.apple.com/*",
        "https://*.paramountplus.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.disneyplus.com/*",
        "https://*.nowtv.com/*",
        "https://*.now.com/*",
        "https://*.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://*.amazon.co.uk/gp/video/*",
        "https://*.amazon.com/gp/video/*",
        "https://*.bbc.co.uk/iplayer/*",
        "https://*.itv.com/watch/*",
        "https://*.channel4.com/*",
        "https://tv.apple.com/*",
        "https://*.paramountplus.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
