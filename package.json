{
  "name": "eclipse",
  "productName": "Eclipse",
  "version": "1.2.0",
  "description": "A personal film and TV tracker",
  "author": "Looby758",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev:phone": "vite --config phone/vite.config.ts",
    "build:phone": "vite build --config phone/vite.config.ts",
    "build:win": "npm run typecheck && npm test && electron-vite build && electron-builder --win --publish never",
    "build:mac": "npm run typecheck && npm test && electron-vite build && electron-builder --mac --publish never"
  },
  "//": "Only the main process's runtime packages go in dependencies; everything the renderer uses is bundled by Vite, so it lives in devDependencies (same as Orbit).",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^36.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "lucide-react": "^0.511.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron-updater": "^6.8.11",
    "zod": "^4.6.7"
  }
}
